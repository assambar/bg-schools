{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "School",
  "description": "One school or preschool in the research tracker. Stored as data/schools/<id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "status"
  ],
  "properties": {
    "id": {
      "description": "Kebab-case slug. Must match the file name (without .yaml).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "type": {
      "type": "string",
      "enum": [
        "kindergarten",
        "preschool",
        "school"
      ]
    },
    "district": {
      "description": "Neighborhood or district in Sofia.",
      "type": "string",
      "pattern": "\\S"
    },
    "website": {
      "description": "http(s) URL.",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^\\s/?#]+\\.[^\\s/?#]+([/?#]\\S*)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "research",
        "check",
        "call-needed",
        "to-visit",
        "visited",
        "shortlisted",
        "rejected"
      ]
    },
    "open_day": {
      "description": "Next known open day (YYYY-MM-DD).",
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "notes": {
      "type": "string"
    }
  }
}
