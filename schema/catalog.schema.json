{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimension catalog",
  "description": "Dimension catalog of a domain (domain.yaml paths.catalog). Cross-field rules (known groups, value sets, record types, methods, scope axes) are checked in src/lib/domain.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups",
    "retrieval_methods",
    "value_sets",
    "dimensions"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)?$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "A generic value type (bool, int, number, text, text_list, url, date, date_list, enum, multi_enum, range, time_range, money) or a record name from `records`."
    },
    "scopable": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods",
        "cadence",
        "automatable",
        "steps"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cadence": {
          "enum": [
            "once",
            "yearly",
            "each_term",
            "monthly"
          ]
        },
        "automatable": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "presence": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bool",
                  "int",
                  "number",
                  "text",
                  "time_range",
                  "enum",
                  "money"
                ]
              },
              "values": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "min": {
                "type": "number"
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "format": {
                "type": "string"
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "retrieval_methods": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "automatable",
          "steps"
        ],
        "properties": {
          "automatable": {
            "type": "boolean"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "value_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      }
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prefix",
          "group",
          "type",
          "members",
          "retrieval"
        ],
        "properties": {
          "prefix": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "group": {
            "type": "string"
          },
          "type": {
            "$ref": "#/$defs/type"
          },
          "scopable": {
            "$ref": "#/$defs/scopable"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "retrieval": {
            "$ref": "#/$defs/retrieval"
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "type",
          "retrieval"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "group": {
            "type": "string"
          },
          "type": {
            "$ref": "#/$defs/type"
          },
          "values": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "scopable": {
            "$ref": "#/$defs/scopable"
          },
          "filter": {
            "type": "boolean"
          },
          "retrieval": {
            "$ref": "#/$defs/retrieval"
          }
        }
      }
    }
  }
}
